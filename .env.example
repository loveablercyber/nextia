# PostgreSQL local (Coolify)
DATABASE_URL=postgresql://usuario:senha@postgres:5432/nextia
DATABASE_SSL=false
APP_URL=https://nextia.dev.br
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Etapa 8 — worker e integrações de automação
AUTOMATION_WORKER_ENABLED=true
AUTOMATION_POLL_INTERVAL_MS=5000
AUTOMATION_BATCH_SIZE=10
AUTOMATION_MAX_ATTEMPTS=5
# Necessário apenas para disparar o endpoint interno /api/internal/automation/process.
AUTOMATION_INTERNAL_SECRET=
# Assinatura HMAC dos webhooks de saída; ações externas também exigem liberação no painel.
NEXTIA_WEBHOOK_SECRET=
# Providers de IA são cadastrados no painel apontando para o nome da variável, nunca para o segredo.
# NEXTIA_AI_PROVIDER_KEY=

# Upload autenticado de arquivos do cliente (não confundir com contas de backup)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Somente para rollback temporário; mantenha false no fluxo comercial atual.
ENABLE_LEGACY_CONTRACT_CREATION=false

# Backups: configure no mínimo duas contas para rotação e failover.
# Formato copiado da variável CLOUDINARY_URL de cada conta.
CLOUDINARY_BACKUP_URL_1=cloudinary://api_key:api_secret@cloud_name_1
CLOUDINARY_BACKUP_URL_2=cloudinary://api_key:api_secret@cloud_name_2
# Alternativa compatível: JSON com duas ou mais URLs.
# CLOUDINARY_URLS=["cloudinary://key:secret@cloud_1","cloudinary://key:secret@cloud_2"]

# Opcional: conta exclusiva para a Central de Materiais.
# Sem esta variável, a conta de backup 1 será usada para os materiais públicos.
CLOUDINARY_MATERIALS_URL=cloudinary://api_key:api_secret@cloud_name_materials

# Mantidas somente para leitura/exclusão de backups legados já existentes.
MINIO_ENDPOINT=https://minio.example.com
MINIO_BUCKET=backups
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_REGION=us-east-1
